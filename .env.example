#服務埠
PORT=8081

# twitch extension secret base64
EXTENSION_SECRET_BASE64=

# （目前未用，留待進階 OAuth 用）
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_APP_TOKEN=

# 取得 App Token 範例指令：
# curl -X POST "https://id.twitch.tv/oauth2/token" -d "client_id=<your_client_id>&client_secret=<your_client_secret>&grant_type=client_credentials"

# 管理端 Token（進階 /admin 用，可先空著或自訂）
ADMIN_TOKEN=change-me
# 環境：development / production
NODE_ENV=development